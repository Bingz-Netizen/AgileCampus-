# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp artifacts
.playwright-mcp/

# 本机 agent 工具配置（.agents/ 与 .claude/skills/ 内容重复）
/.agents/
/.claude/launch.json

# 本机开发脚本（一键启动等；init-test-db.sql 已跟踪不受影响）
/scripts/

# IDE 配置
.idea/

# AI 开发上下文文档（非功能代码）
Project.md
